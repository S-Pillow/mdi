# MDI Backend — copy to .env and fill in values on the production host.
# This file is safe to commit. Never commit the real .env file.

# VirusTotal API key.
# Reuse the same key as vt-bulk-check. Injected via systemd EnvironmentFile.
VT_API_KEY=

# Shared VT usage file — must match vt-bulk-check VT_USAGE_FILE.
VT_USAGE_FILE=/var/lib/dns-tool/vt_usage.json

# Shared VT per-job JSONL usage history — must match vt-bulk-check path.
VT_USAGE_HISTORY_FILE=/var/lib/dns-tool/vt_usage_history.jsonl

# Shared VT rolling 90-day daily history — must match vt-bulk-check path.
VT_DAILY_HISTORY_FILE=/var/lib/dns-tool/vt_daily_history.json
